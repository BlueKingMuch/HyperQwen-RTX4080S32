+def _vocab_replaced_by_target(vllm_config: VllmConfig) -> bool:
+    """Whether the draft's lm_head, and without pipeline parallelism its
+    embedding, is built without storage. Both are replaced by the target's after
+    loading; a head tied to the embedding, or untied by the checkpoint, still
+    gets the full construction."""
+    model_config = vllm_config.model_config
+    return not (
+        model_config.hf_text_config.tie_word_embeddings
+        or model_config.word_embeddings_untied_by_checkpoint
+    )
