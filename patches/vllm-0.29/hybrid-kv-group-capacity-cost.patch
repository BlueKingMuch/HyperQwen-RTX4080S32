+def _hybrid_group_capacity_cost(
+    vllm_config: VllmConfig,
+    kv_cache_spec: dict[str, KVCacheSpec],
+    layer_buckets: list[list[str]],
+    group_size: int,
+) -> int:
+    """Exact max-request cost of a general-allocator grouping candidate."""
+    grouped_layers: list[list[str]] = []
+    for layers in layer_buckets:
+        num_groups = cdiv(len(layers), group_size)
+        grouped_layers.extend(layers[i::num_groups] for i in range(num_groups))
+
+    # Materialize exactly the groups used by the allocator. In particular,
+    # merge() must run on each real strided subset, not on one representative
+    # spec for the whole bucket.
+    groups = create_kv_cache_group_specs(kv_cache_spec, grouped_layers)
+    physical_group_size = max(len(group.layer_names) for group in groups)
+    common_page_size = get_uniform_page_size(
+        group.kv_cache_spec for group in groups
+    )
+    blocks_per_max_request = sum(
+        cdiv(
+            group.kv_cache_spec.max_memory_usage_bytes(vllm_config),
+            group.kv_cache_spec.page_size_bytes,
+        )
+        for group in groups
+    )
+    return common_page_size * physical_group_size * blocks_per_max_request
+
