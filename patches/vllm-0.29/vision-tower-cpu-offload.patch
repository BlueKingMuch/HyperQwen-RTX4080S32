+def _bulk_offload_qwen3_vision_modules(
+    modules_generator: Generator[nn.Module, None, None],
+) -> list[nn.Module]:
+    cpu_offload_gb = envs.VLLM_VISION_CPU_OFFLOAD_GB
+    if cpu_offload_gb <= 0:
+        return list(modules_generator)
+
+    from vllm.model_executor.offloader import UVAOffloader
+
+    offloader = UVAOffloader(cpu_offload_max_bytes=int(cpu_offload_gb * 1024**3))
+    # Keep GEMMs on device-local weights. UVA zero-copy would make every GEMM
+    # read its weight tiles over PCIe instead of copying each module once.
+    offloader.uva_offloading = False
+    return offloader.wrap_modules(modules_generator)
