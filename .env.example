# Copy this file to .env before starting Docker Compose.
# .env is ignored by git, so local keys and tuning stay out of commits.
#
# This is the configuration this repository is currently measured on: one
# RTX 4080 SUPER 32 GB (sm89, Ada) at 250 W, undervolted, WSL2 + Docker,
# serving agentic clients that fan out subagents — several concurrent streams,
# long contexts, mostly prefix-cached follow-up requests.
#
# Start it with the Compose profile, since `single` and `batch` sit behind one:
#
#     docker compose --profile single up -d
#
# Every variable below is read by single-user/start_qwen.sh unless the comment
# says otherwise. Values shown are what this box runs; the launcher's own
# defaults are named where they differ, because three of them differ in ways
# that matter.


# ---------------------------------------------------------------- the weights

# Host side of the bind mount. The path inside the container is always
# /app/models, whatever this is set to.
MODELS_DIR=./models

# Container-side path, so it starts with /app/models — a host path here does
# not resolve. A path ending in .gguf additionally makes the launcher emit
# --quantization gguf plus --tokenizer and --hf-config-path, taken from an
# hfconfig/ directory beside the file if there is one, otherwise from the
# file's own directory. Launcher default when MODEL is empty: the
# W4A16-AutoRound-fast directory if it exists, which is picked silently.
MODEL=/app/models/Qwen3.8-27B-ByteShape-GPU5/Qwen3.8-27B-IQ4_XS-3.84bpw.gguf


# --------------------------------------------------------------- the KV profile

# CTX picks the KV dtype, the attention backend, the block size, the context
# window and the draft depth as one profile. Unknown values are refused before
# anything boots.
#
#   fast   65,536 tokens, FLASH_ATTN
#   long   ~150k
#   huge   the KVarN 4/2-bit KV cache, ~240k
#   fp8    the FP8 Triton attention steps of fp8/
#   int4   the int4 per-token-head KV cache on the Triton backend, 262,144
CTX=int4

# Reuses the attention KV of a shared prompt prefix and resumes the recurrent
# GDN state from the last aligned block boundary instead of re-running the
# prompt. Prepends --enable-prefix-caching --mamba-cache-mode align. Tested for
# the exact string 1; 0, true, yes and on are all "off". Launcher default: 0.
PREFIX_CACHE=1

# Empty means "do not pin the pool, size it from GPU_UTIL". Leaving the line
# out entirely is NOT the same thing: unset makes the launcher take the
# profile's own byte pin. Both forms are deliberate, so keep the empty
# assignment if you want utilization sizing.
KV_MEM=

# The fraction of VRAM vLLM may claim, and therefore the pool size whenever
# KV_MEM is empty. The launcher's default is 0.93, not 0.88 — the
# `GPU_UTIL:-0.88` lines inside the CTX=fp8 and CTX=int4 arms never fire,
# because line 143 has already assigned 0.93. This line is doing real work.
GPU_UTIL=0.88


# ------------------------------------------------------- speculative decoding

# mtp | dflash2 | off | none. Anything else is refused twice before boot.
# dflash2 is the DFlash2 block drafter and needs its checkpoint present.
SPEC=dflash2

# The draft checkpoint, as a container-side path. Read only on the SPEC=dflash2
# path — the mtp branch emits no model at all, because that head sits in the
# target. Unlike KV_MEM, an empty DRAFT and an absent DRAFT are the same thing.
#
# Empty means "go and find it": the launcher takes the first of
# models/Qwen3.8-27B-DFlash2-W4A16 and models/Qwen3.8-27B-DFlash2 that holds a
# model.safetensors, and refuses to boot if neither does. It probes for that one
# filename, so a GGUF drafter — or a sharded checkpoint — is never found this
# way and has to be named here. Nothing else is checked: the value is
# interpolated into the speculative config as "model" exactly as written.
#
# A path ending in .gguf sends the draft through the GGUF plugin
# (gguf-plugin/patches/gguf-dflash2-draft-gguf.patch). It needs a config.json
# beside the file: something that identifies the drafter — a dflash_config, or
# architectures: ["DFlash2DraftModel"] — and a quantization_config whose
# quant_method is gguf. That second one is payload and not just a switch: its
# unquantized_modules list is what holds qkv_proj, the two kernel projections
# and the candidate selector dense, which are the modules the adapter
# dequantizes on the way in. A draft does not inherit the engine's quant
# config — vLLM builds it one from the draft's own checkpoint — so with the
# key absent it gets none and the load fails.
#
# Those dense modules are 0.703 GB resident (0.654 GiB) whatever the file is
# quantized to, against 0.200 GB of the Q4_K_M file: a smaller rung frees less
# than its size suggests.
#
# Measured here at DFLASH_TOKENS=7, seven rungs from bf16 down to Q2_K, two runs
# each, against the W4A16 drafter. Acceptance is task-dependent and bit width
# orders nothing. All of them converge on the saturated copy task, 7.83-7.94
# tok/step. W4A16 leads on summary and qa in both runs (2.14 against
# 1.96-2.12; 2.55-2.58 against 2.30-2.53); on edit five of the seven lead it
# instead, 1.91-1.97 against 1.43, and on code four do, up to 4.00 against
# 3.57-3.60. Q2_K is the one rung that breaks: code 2.67 in both runs.
#
# Past 2 GiB of drafter weights the launcher prints the size beside the memory
# settings. That is a WARNING only when KV_MEM is pinned and neither
# DFLASH_MAX_LEN nor MAX_LEN is set; this file leaves KV_MEM empty, which on
# its own makes it a note.
DRAFT=

# The verify block length under SPEC=dflash2. Crossing 7 changes five other
# things at once, including the CUDA-graph size, so see the trap at the bottom
# of this file before raising it.
DFLASH_TOKENS=7

# Highest-precedence context window, but only on the SPEC=dflash2 path, where
# it beats MAX_LEN. 262,144 is what the CTX=int4 profile would choose anyway,
# so this line states the intent rather than changing anything. Under SPEC=mtp
# or SPEC=off it is read nowhere.
DFLASH_MAX_LEN=262144

# Admission limit, not residency: each resident request first takes recurrent
# state slots out of the same pool, and the launcher prints how many the pool
# really holds. Raising this past that number only queues and then preempts.
MAX_SEQS=8


# ------------------------------------------------------------- the GDN layers

# 48 of the model's 64 layers are Gated DeltaNet, and this types their
# recurrent state cache.
#
# The launcher's default is float16, and float16 is NOT in vLLM's
# FUSED_GDN_STATE_DTYPES, which holds only float32 and bfloat16. The default
# therefore drops every one of those 48 layers off the fused CUDA path.
# bfloat16 costs the same bytes and keeps the fused kernel. Set it explicitly.
MAMBA_SSM_DTYPE=bfloat16


# ------------------------------------------------------------------- the tower

# 1 loads the vision tower; anything else emits --language-model-only and the
# tower's weights are never loaded. When on, the launcher emits a one-image
# limit and a pixel cap, because vLLM profiles the encoder at the largest image
# it will accept and that peak comes out of the KV pool.
VISION=1


# --------------------------------------------------------- engine-side passthrough

# Neither of these is read by any script in this repository. They reach vLLM
# only because Compose hands .env straight to the container.

# Treats max_tokens as a ceiling rather than a reservation, so a request whose
# prompt fits the window is accepted even when prompt + max_tokens would not.
# Without it a client with a fixed max_tokens safety cap cannot use long
# contexts at all (upstream vLLM #42474; the fix is local to this fork).
VLLM_RENDERER_CLAMP_MAX_TOKENS=1

VLLM_WSL2_ENABLE_PIN_MEMORY=1


# ----------------------------------------------------------------- EXTRA_ARGS

# Appended last to the vLLM command line, so it overrides every flag the
# launcher emitted. It is word-split, so no single argument may contain a
# space — the JSON below works only because it has none.
#
# The launcher also inspects it: it sniffs --tensor-parallel-size, and it
# refuses --dtype float16/fp16/half unless SPEC is off or none, because the
# split-KV verify kernel is bf16-only. resolve_config.sh warns when EXTRA_ARGS
# shadows a flag the launcher already set.
#
# Here it does two things.
#
# It raises the image limit the VISION=1 branch set to 1.
#
# And it moves structured output from vLLM's default backend (`auto`, which
# picks xgrammar) to guidance. With speculative decoding the scheduler fills a
# grammar bitmask for every draft position and once more for the bonus token,
# serially, on its main thread: eight fills per step at DFLASH_TOKENS=7, each
# over Qwen's 248,320-token vocabulary. Measured with a coding harness that
# constrains every action, same request and configuration otherwise: xgrammar
# 6-8.6 tok/s with the GPU at 0-3% and one CPU core full, guidance 113-132
# tok/s with the GPU at 98%. Requests without a grammar do not take this path.
# A client sends one through `structured_outputs`, a `response_format`
# json_schema, or a forced `tool_choice`.
EXTRA_ARGS=--limit-mm-per-prompt {"image":{"count":600}} --structured-outputs-config {"backend":"guidance"}


# =============================================================================
# Optional. Uncomment only when you want the behaviour described.
# =============================================================================

# PORT=18020
# Moves the served port. Compose reads the same variable for the published
# mapping and the healthcheck, so changing it here keeps both sides in step —
# changing it via EXTRA_ARGS does not, and leaves nothing published.

# MAX_BATCHED=2048
# The prefill chunk. Measured on this box: 8192 saves about 10 % of a cold
# prefill but triples cached follow-up TTFT and cuts the pool about 16 %.

# REQ_METRICS=1
# Per-request timing and usage on every response, plus the speculative-decoding
# acceptance numbers. Cannot be combined with --disable-log-stats in EXTRA_ARGS,
# because the timing fields ride the engine-stats path.

# INT8_ACT=int8
# INT8_LAYERS=<regex>
# The W4A8 Marlin path: weights stay int4, activations are quantized per token.
# INT8_LAYERS is read only when INT8_ACT is also set.

# PREFILL_ATTN=1
# int8-QK Triton attention for the head_dim-256 full-attention layers during
# prefill.

# VISION_OFFLOAD=0
# Keeps the vision tower's weights on the GPU instead of in pinned host RAM.
# Default is 1. On a 24 GB card turning it off does not boot with
# SPEC=dflash2 + VISION=1; on 32 GB there is more room, so this is one of the
# few places a larger card legitimately diverges from this file.

# TOOLS=0
# Drops --enable-auto-tool-choice and the tool-call parser. Default is 1, and
# without both flags vLLM rejects any request carrying `tools`. Leave it on for
# agentic clients.

# CG=64
# The maximum CUDA-graph capture size. Normally derived from MAX_SEQS and the
# draft count; set it by hand only when that derivation overshoots (below).


# =============================================================================
# Traps. Each of these is silent, or fatal, or both.
# =============================================================================

# DFLASH_TOKENS=15 together with MAX_SEQS=8 asks for a CUDA-graph size the card
# cannot hold. The engine boots, answers /health, and then dies with
# torch.OutOfMemoryError on the first concurrent batch. Either lower MAX_SEQS
# or set CG by hand. DFLASH_TOKENS=15 is "reproduction mode": it pays off when
# the model is quoting its own context, and costs request slots and window.

# DRAFT_TOKENS does nothing under SPEC=dflash2 — the launcher overwrites it
# with DFLASH_TOKENS. It is the SPEC=mtp knob.

# SERVED_NAME does not exist. The served id is hardcoded to qwen3.8-27b; the
# only way to change it is --served-model-name inside EXTRA_ARGS.

# The variable is API_SERVERS, not API_SERVER_COUNT. The latter is read nowhere.

# MAX_LEN loses to DFLASH_MAX_LEN on the dflash2 path. A .env that sets only
# DFLASH_MAX_LEN and then switches to SPEC=mtp silently falls back to the CTX
# arm's own window.

# KV is the batch service's KV-tier selector, not a single-user variable.
