+// Launch helper: chunks of up to 16 vectors (NV 8 for a verify batch of one
+// sequence, 16 for two), the q8_1 rows and the output advanced per chunk.
+template <typename scalar_t, int qk, int qi, typename block_q_t, int vdr, vec_dot_q_cuda_t vec_dot_q_cuda>
+static void launch_mul_mat_vec_q_batched(const void * vx, const void * vy, scalar_t * dst, const int ncols, const int nrows, const int nvecs, cudaStream_t stream) {
+    const int block_num_y = (nrows + GGML_CUDA_MMV_Y - 1) / GGML_CUDA_MMV_Y;
