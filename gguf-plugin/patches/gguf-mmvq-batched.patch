+// gguf-rco step 6a: batched over up to NV vectors. The upstream kernel of
+// b2899 launched one block per (row, vector) and re-read the row's weights
+// for every vector; here the row's quantized blocks are read once per step
+// and dotted against every vector (the repeated decode hits L1). The
+// accumulation order per vector is unchanged, so a vector's result is
+// bit-identical to the single-vector launch.
+template <typename scalar_t, int NV, int qk, int qi, typename block_q_t, int vdr, vec_dot_q_cuda_t vec_dot_q_cuda>
 static __global__ void mul_mat_vec_q(const void * __restrict__ vx, const void * __restrict__ vy, scalar_t * __restrict__ dst, const int ncols, const int nrows, const int nvecs) {
