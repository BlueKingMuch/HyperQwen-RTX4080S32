+def _is_gguf_model(model_config: ModelConfig) -> bool:
+    """gguf-rco draft bridge: does this model config point at GGUF weights?
+
+    The engine-args patch sets ``load_format = gguf`` for the whole engine
+    when the target is a GGUF reference, so every model the engine loads
+    through ``get_model_loader`` arrives here - including a speculative
+    draft shipped as safetensors (compressed-tensors) in a plain directory.
+    Such a model is handed to vLLM's default loader with its own
+    quantization config; anything else stays on the GGUF path.
+    """
+    reference = model_config.model_weights or model_config.model
+    if not reference:
+        return True
+    reference = str(reference)
+    return reference.endswith(".gguf") or is_gguf(reference)
+
